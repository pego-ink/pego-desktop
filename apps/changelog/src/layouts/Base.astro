---
import "@/styles/global.css";
import fontUrl from "@/assets/fonts/inter-latin.woff2?url";
import Logo from "@/components/Logo.astro";
import { serializeJsonLd } from "@/lib/json-ld";
import { APP_URL, GITHUB_URL, SITE_NAME, SITE_URL } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  /** "article" for an entry page, "website" otherwise. */
  type?: "website" | "article";
  publishedTime?: Date;
  /** One or more JSON-LD objects. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, type = "website", publishedTime, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL("/pego-mark.png", SITE_URL).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f8f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09150f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/pego-mark.png" />
    <link rel="alternate" type="application/rss+xml" title="Pego changelog" href="/rss.xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={`${SITE_NAME} changelog`} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="The Pego logo" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ld.map((item) => <script type="application/ld+json" set:html={serializeJsonLd(item)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="wrap site-header">
      <a class="brand" href="/" aria-label="Pego changelog home" aria-current={isHome ? "page" : undefined}>
        <Logo />
        <b>Pego</b>
        <span>Changelog</span>
      </a>
      <nav class="site-nav" aria-label="Site">
        <a class="secondary" href={GITHUB_URL}>GitHub</a>
        <a class="cta" href={APP_URL}>Open Pego</a>
      </nav>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>Pego, an open alternative to Pencil.</p>
        <nav aria-label="Footer">
          <a href="/rss.xml">RSS feed</a>
          <a href={GITHUB_URL}>GitHub</a>
          <a href={APP_URL}>Open Pego</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
