---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Image } from "astro:assets";
import Tags from "@/components/Tags.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { formatDate, isoDay } from "@/lib/format-date";

interface Props {
  entry: CollectionEntry<"entries">;
  /** "list": one of many on the index (title is an h2). "page": the entry's own page (title is the h1). */
  variant: "list" | "page";
}

const { entry, variant } = Astro.props;
const { Content } = await render(entry);
const { title, date, summary, tags, version, image, imageAlt } = entry.data;
const isPage = variant === "page";
const Heading = isPage ? "h1" : "h2";
---

<article class="entry" id={isPage ? undefined : entry.id}>
  <div class="entry-meta">
    {
      isPage ? (
        <time datetime={isoDay(date)}>{formatDate(date)}</time>
      ) : (
        <a href={`#${entry.id}`}>
          <time datetime={isoDay(date)}>{formatDate(date)}</time>
        </a>
      )
    }
    {version && <span class="entry-version">v{version}</span>}
  </div>
  <div class="entry-body">
    <Tags tags={tags} />
    <Heading class="entry-title">
      {isPage ? title : <a href={`/${entry.id}`}>{title}</a>}
    </Heading>
    {isPage && <p class="entry-summary">{summary}</p>}
    {
      image && (
        <Image
          class="entry-image"
          src={image}
          alt={imageAlt ?? ""}
          widths={[640, 960, 1280]}
          sizes="(min-width: 48rem) 40rem, 100vw"
          loading="lazy"
          decoding="async"
        />
      )
    }
    <div class="prose">
      <Content components={isPage ? {} : { h2: SectionHeading }} />
    </div>
  </div>
</article>
