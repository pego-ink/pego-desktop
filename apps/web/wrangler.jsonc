// The hosted web editor: a static-assets Worker (no script) serving the Vite build.
// Deployed by .github/workflows/deploy-web.yml; build first with `bun run --cwd apps/web build`.
{
  "name": "pego-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "workers_dev": true,
  "preview_urls": true,
}
