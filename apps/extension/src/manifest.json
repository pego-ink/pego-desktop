{
  "manifest_version": 3,
  "name": "Pego",
  "version": "0.1.0",
  "description": "Send web pages, elements and screenshots to the Pego design editor as editable layers.",
  "minimum_chrome_version": "116",
  "action": { "default_popup": "popup.html", "default_title": "Send to Pego" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"]
}
